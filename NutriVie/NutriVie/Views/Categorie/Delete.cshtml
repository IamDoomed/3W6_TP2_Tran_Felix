@model NutriVie.Models.Categorie

@{
    ViewData["Title"] = "Delete";
    bool hasRecipes = Model.Recettes != null && Model.Recettes.Any();
}

<h1>Delete</h1>

<div>
    <h4>Are you sure you want to delete this?</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Nom)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Nom)
        </dd>
    </dl>
    @if (hasRecipes)
    {
        <div style="color: gold;">Vous ne pouvez pas supprimer cette catégorie parce qu'elle contient des recettes</div>
    }
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        @* <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a> *@
        @if (hasRecipes)
        {
            <button type="submit" value="Delete" class="btn btn-danger rounded-pill" disabled title="remove all recipes first pendejo">
                <i class="fa-solid fa-trash me-1"></i> Delete
            </button>
        }
        else
        {

            <button type="submit" value="Delete" class="btn btn-danger rounded-pill">
                <i class="fa-solid fa-trash me-1"></i> Delete
            </button>
        }
        <a asp-action="Index" class="btn btn-secondary rounded-pill">
            <i class="fa-solid fa-circle-arrow-left me-1"></i> Back to List
        </a>
    </form>
</div>
