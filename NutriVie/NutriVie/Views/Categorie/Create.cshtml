@model NutriVie.Models.Categorie

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Categorie</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Nom" class="control-label"></label>
                <input asp-for="Nom" class="form-control" />
                <span asp-validation-for="Nom" class="text-danger"></span>
            </div>
            @if (ViewBag.NameExists == true)
			{
				<div style="color: gold;">Cette catégorie existe déjà.</div>
			}
            

            
           @* <button type="submit" class="btn btn-primary rounded-pill">
                <i class="fa-solid fa-plus me-1"></i> Create
           </button>
            
            <a asp-action="Index" class="btn btn-secondary rounded-pill">
                <i class="fa-solid fa-circle-arrow-left me-1"></i> Back to List
            </a> *@

            <partial name="_BoutonCreate" />
        </form>
    </div>
</div>
