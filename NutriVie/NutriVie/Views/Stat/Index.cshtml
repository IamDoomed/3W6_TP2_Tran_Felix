@model StatsVM

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

<h1>Stats</h1>

<p class="stat-line">
    Le nombre de recettes avec 3 aliments: <strong>@Model.NombreRecettesTroisAliments</strong>
</p>

<p class="stat-line">
    L'aliment le plus calorique : <strong>@Model.AlimentPlusCalorique</strong>
</p>

<h2>La liste des 4 recettes qui ont le plus court temps total (préparation et cuisson) en affichant le nom et le temps total</h2>

<table class="table-stats">
    <thead>
        <tr>
            <th>Nom de la recette</th>
            <th>Temps total</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var recette in ViewBag.RecettesCourtes)
        {
            <tr>
                <td>@recette.Nom</td>
                <td>@recette.TempsTotal</td>
            </tr>
        }
    </tbody>
</table>

<p class="stat-line">
    Le nombre de calories de la recette française la moins calorique : <strong>@Model.CaloriesRecetteFrancaiseMoinsCalorique.ToString("N2")</strong>
</p>